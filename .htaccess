Options -Indexes +FollowSymLinks
RewriteEngine On
RewriteBase /

# 1. Block Hidden Files
RewriteRule ^\.(.*)$ - [F]

# 2. Static Folders Direct Bypass (Assets, Data, JS, CSS)
RewriteRule ^(assets|data|js|css)/ - [L]

# 3. Real Files & Directory Passthrough
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 4. Static Pages
RewriteRule ^about-us/?$ about-us.html [L,QSA]
RewriteRule ^contact-us/?$ contact-us.html [L,QSA]
RewriteRule ^privacy-policy/?$ privacy-policy.html [L,QSA]
RewriteRule ^terms/?$ terms.html [L,QSA]
RewriteRule ^pricing/?$ pricing.html [L,QSA]
RewriteRule ^tests/?$ tests.html [L,QSA]

# 5. App & Runner
RewriteRule ^dashboard/web/?$ dashboard_web.html [L,QSA]
RewriteRule ^dashboard/?$ dashboard_mobile_exam.html [L,QSA]
RewriteRule ^test/runner/?$ web_exam_runner.html [L,QSA]

# 6. Blogs
RewriteRule ^blogs/?$ blogs.html [L,QSA]
RewriteRule ^blogs/([^/]+)/?$ blog-detail.html?slug=$1 [L,QSA]

# 7. 8 Explicit Exam Routes
RewriteRule ^ssc/?$ exam-detail.html?exam=ssc [L,QSA]
RewriteRule ^upsc/?$ exam-detail.html?exam=upsc [L,QSA]
RewriteRule ^banking/?$ exam-detail.html?exam=banking [L,QSA]
RewriteRule ^railways/?$ exam-detail.html?exam=railways [L,QSA]
RewriteRule ^jee-neet/?$ exam-detail.html?exam=jee-neet [L,QSA]
RewriteRule ^defence/?$ exam-detail.html?exam=defence [L,QSA]
RewriteRule ^teaching/?$ exam-detail.html?exam=teaching [L,QSA]
RewriteRule ^entrance/?$ exam-detail.html?exam=entrance [L,QSA]

# 8. Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>