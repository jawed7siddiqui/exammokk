RewriteEngine On

# 1. Map /about-us to about-us.html
RewriteRule ^about-us/?$ about-us.html [L,QSA]

# 2. Map /contact-us to contact-us.html
RewriteRule ^contact-us/?$ contact-us.html [L,QSA]
RewriteRule ^guide/?$ guide.html [L,QSA]
RewriteRule ^coloring-pages/?$ coloring-pages.html [L,QSA]

RewriteRule ^ar/?$ ar.html [L,QSA]
RewriteRule ^es/?$ es.html [L,QSA]

RewriteRule ^school/([^/]+)/?$ index.html [L,QSA]

RewriteRule ^blogs/?$ blogs.html [L,QSA]

# Map /blogs/slug-name to blog-detail.html (Single Blog Detail)
RewriteRule ^blogs/([^/]+)/?$ blog-detail.html [L,QSA]