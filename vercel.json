{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/editor/(.*)",
      "destination": "/editor.html"
    },
    {
      "source": "/coloring-pages",
      "destination": "/coloring-pages.html"
    },
    {
      "source": "/about-us",
      "destination": "/about-us.html"
    },
    {
      "source": "/contact-us",
      "destination": "/contact-us.html"
    },
    {
      "source": "/guide",
      "destination": "/guide.html"
    },
    {
      "source": "/ar",
      "destination": "/lang/ar/index.html"
    },
    {
      "source": "/ar/",
      "destination": "/lang/ar/index.html"
    }
  ]
}
