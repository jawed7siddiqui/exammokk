{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/data/(.*)",
      "dest": "/data/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/(ssc|upsc|banking|railways|jee-neet|defence|teaching|entrance)",
      "dest": "/exam-detail.html"
    },
    {
      "src": "/blogs/([^/]+)",
      "dest": "/blog-detail.html"
    },
    {
      "src": "/test/runner",
      "dest": "/web_exam_runner.html"
    },
    {
      "src": "/dashboard/web",
      "dest": "/dashboard_web.html"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard_mobile_exam.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
