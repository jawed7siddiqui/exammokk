{
  "rewrites": [
    {
      "source": "/about-us",
      "destination": "/about-us.html"
    },
    {
      "source": "/contact-us",
      "destination": "/contact-us.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/tests",
      "destination": "/tests.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard_mobile_exam.html"
    },
    {
      "source": "/dashboard/web",
      "destination": "/dashboard_web_exam.html"
    },
    {
      "source": "/blogs",
      "destination": "/blogs.html"
    },
    {
      "source": "/blogs/:slug",
      "destination": "/blog-detail.html"
    },
    {
      "source": "/:exam",
      "destination": "/exam-detail.html"
    }
  ]
